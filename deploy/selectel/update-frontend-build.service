[Unit]
Description=Build Update You frontend from GitHub main
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=update-frontend-build
StateDirectory=update-frontend-build
StateDirectoryMode=0750
WorkingDirectory=/var/lib/update-frontend-build
Environment=HOME=/var/lib/update-frontend-build
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/update/frontend-build.env
ExecStart=/usr/local/libexec/update-frontend/build.sh
TimeoutStartSec=12min
Nice=10
CPUQuota=100%
MemoryHigh=900M
MemoryMax=1300M
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
